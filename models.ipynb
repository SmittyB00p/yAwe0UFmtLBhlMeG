    "\n",
    "    return {'loss': -acc, 'status': STATUS_OK}\n",
    "\n",
    "trials = Trials()\n",
    "\n",
    "best = fmin(fn=hyperparameter_tuning, space=space, algo=hyperopt.tpe.suggest, trials=trials, max_evals=100, verbose=0)\n",
    "\n",
    "print(best)"
